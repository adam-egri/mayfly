  <script>
    fetch("data/date.txt")
    .then(response => response.text())
    .then(text => {
	// find line starting with "month:"
	const match_month = text.match(/^month:\s*(\w+)/mi);	
	if (match_month) {
	    const month = match_month[1];
	    document.getElementById("month").textContent = month;
	}
	const match_day = text.match(/^day:\s*(\w+)/mi);	
	if (match_day) {
	    const day = match_day[1];
	    document.getElementById("day").textContent = day;
	}
    });
  </script>
  
